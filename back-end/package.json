{
    "name": "easy-school",
    "version": "1.0.0",
    "description": "School management system back end part",
    "author": "Ayoub JABIRI",
    "type": "module",
    "main": "server.js",
    "scripts": {
        "dev": "nodemon --import dotenv/config server.js",
        "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --setupFiles dotenv/config",
        "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --setupFiles dotenv/config --watch"
    },
    "dependencies": {
        "bcrypt": "^6.0.0",
        "dotenv": "^17.4.2",
        "express": "^5.2.1",
        "jsonwebtoken": "^9.0.3",
        "mongoose": "^9.8.1",
        "zod": "^4.4.3"
    },
    "devDependencies": {
        "jest": "^30.4.2",
        "mongodb-memory-server": "^11.2.0",
        "nodemon": "^3.1.14",
        "supertest": "^7.2.2"
    },
    "jest": {
        "testEnvironment": "node",
        "setupFilesAfterEnv": [
            "<rootDir>/__tests__/setup.js"
        ],
        "testPathIgnorePatterns": [
            "<rootDir>/__tests__/setup.js"
        ]
    }
}
